<Page
    x:Class="DriftZipApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DriftZipApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="HomePage_DragOver"
    Drop="HomePage_Drop"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="LargeIconTemplate" x:DataType="local:ArchiveItem">
            <StackPanel Width="120" Padding="8" HorizontalAlignment="Center">
                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="12"
                           MaxLines="2" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SmallIconTemplate" x:DataType="local:ArchiveItem">
            <StackPanel Orientation="Horizontal" Padding="8">
                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16"/>
                <TextBlock Text="{x:Bind Name}" Margin="8,0,0,0" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetailsTemplate" x:DataType="local:ArchiveItem">
            <Grid Padding="8,4" MinWidth="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Content="←" Click="Back_Click" Visibility="Collapsed" ToolTipService.ToolTip="后退"/>
            <Button Grid.Column="1" x:Name="ForwardButton" Content="→" Click="Forward_Click" Visibility="Collapsed" ToolTipService.ToolTip="前进"/>
            <Button Grid.Column="2" x:Name="UpButton" Content="↑" Click="Up_Click" Visibility="Collapsed" ToolTipService.ToolTip="上级"/>
            <Button Grid.Column="3" Content="刷新" Click="Refresh_Click"/>
            <AutoSuggestBox Grid.Column="4" x:Name="PathBox" QuerySubmitted="PathBox_QuerySubmitted" PlaceholderText="输入路径或搜索"/>
            <TextBlock Grid.Column="5" x:Name="StatusText"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <StackPanel x:Name="BreadcrumbPanel" Grid.Row="1" Orientation="Horizontal"
                    Spacing="4" Padding="12,0,12,8" Visibility="Collapsed"/>

        <GridView x:Name="ArchiveGridView"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Grid.Row="2"
                  Padding="12"
                  IsItemClickEnabled="True"
                  ItemClick="ArchiveGridView_ItemClick"
                  DoubleTapped="ArchiveGridView_DoubleTapped"
                  RightTapped="ArchiveGridView_RightTapped"
                  CanDragItems="True"
                  DragItemsStarting="ArchiveGridView_DragItemsStarting"
                  ItemsSource="{x:Bind ViewModel.ArchiveItems, Mode=OneWay}"
                  SelectionMode="Extended"
                  ItemTemplate="{StaticResource LargeIconTemplate}">
        </GridView>

        <ListView x:Name="ArchiveListView"
                  Grid.Row="2"
                  Padding="12"
                  Visibility="Collapsed"
                  IsItemClickEnabled="True"
                  ItemClick="ArchiveGridView_ItemClick"
                  DoubleTapped="ArchiveGridView_DoubleTapped"
                  RightTapped="ArchiveGridView_RightTapped"
                  CanDragItems="True"
                  DragItemsStarting="ArchiveGridView_DragItemsStarting"
                  ItemsSource="{x:Bind ViewModel.ArchiveItems, Mode=OneWay}"
                  SelectionMode="Extended"
                  ItemTemplate="{StaticResource DetailsTemplate}">
        </ListView>

        <ProgressBar x:Name="OperationProgress" Grid.Row="3" VerticalAlignment="Bottom" Height="4" Visibility="Collapsed"/>
    </Grid>
</Page>
