<Page
    x:Class="DriftZipApp.Pages.ArchivePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DriftZipApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Button x:Name="GoUpButton" Content="↑ 返回上级" Click="GoUp_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="ArchivePathText" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Text="未加载"/>
            <TextBlock x:Name="CurrentPathText" VerticalAlignment="Center" Foreground="Gray" Text=""/>
            <Button Content="测试压缩包" Click="TestArchive_Click"/>
            <Button Content="查看属性" Click="ShowProperties_Click"/>
            <Button Content="添加文件..." Click="AddFiles_Click"/>
        </StackPanel>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1"
                        PlaceholderText="搜索包内文件..."
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        TextChanged="SearchBox_TextChanged"
                        Margin="0,0,0,8"/>

        <Grid Grid.Row="2" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="名称" Click="Sort_Click" Tag="Name"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="1" Content="大小" Click="Sort_Click" Tag="Size"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="2" Content="压缩后" Click="Sort_Click" Tag="CompressedSize"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="3" Content="压缩率" Click="Sort_Click" Tag="Ratio"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="4" Content="CRC" Click="Sort_Click" Tag="Crc"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="5" Content="修改日期" Click="Sort_Click" Tag="Modified"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0"/>
        </Grid>

        <ListView x:Name="EntryList"
                  Grid.Row="3"
                  CanDragItems="True"
                  DragItemsStarting="EntryList_DragItemsStarting"
                  DoubleTapped="EntryList_DoubleTapped"
                  SelectionMode="Extended">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="解压到…" Click="ExtractEntryTo_Click"/>
                    <MenuFlyoutItem Text="解压到此目录" Click="ExtractEntryHere_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="重命名" Click="RenameEntry_Click"/>
                    <MenuFlyoutItem Text="删除" Click="DeleteEntry_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="复制路径" Click="CopyEntryPath_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ArchiveEntry">
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16"/>
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind CompressedSizeText}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind RatioText}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind CrcText}"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind ModifiedText}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar x:Name="OperationProgress" Grid.Row="4" Height="4" Visibility="Collapsed"/>
    </Grid>
</Page>