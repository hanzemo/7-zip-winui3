<Page
    x:Class="SevenZipApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,0,8,0">
            <AppBarButton Icon="OpenFile" Label="打开">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBox x:Name="LatestArchivePath" PlaceholderText="输入压缩包路径" Margin="0,0,0,8"/>
                            <Button Content="打开" FontWeight="Bold" Command="{x:Bind ViewModel.OpenCommand}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.RecentArchives}" DisplayMemberPath="Name" SelectionChanged="RecentCompressedChanged"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="刷新" Click="Refresh_Click"/>
            <AppBarButton Icon="Open" Label="解压到" Command="{x:Bind ViewModel.ExtractToFolderCommand}"/>
        </CommandBar>

        <Grid Grid.Row="1">
            <GridView x:Name="ArchiveGridView"
                      ItemsSource="{x:Bind ViewModel.ArchiveItems}"
                      SelectionMode="Single"
                      ItemClick="ArchiveGridView_ItemClick"
                      Loaded="ArchiveGridView_Loaded">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Padding="16,16,16,16"
                                    CornerRadius="8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{x:Bind Count}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <TextBlock Grid.Row="2"
                   Foreground="{ThemeResource TextFillColorPrimary}"
                   Text="{x:Bind ViewModel.StatusMessage}"
                   Padding="8,8,8,8"/>

    </Grid>

</Page>
