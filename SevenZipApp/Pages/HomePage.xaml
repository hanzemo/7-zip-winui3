<Page
    x:Class="SevenZipApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SevenZipApp"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,0,8,0">
            <AppBarButton Icon="OpenFile" Label="打开" Click="Open_Click"/>
            <AppBarButton Icon="Refresh" Label="刷新" Click="Refresh_Click"/>
            <AppBarButton Icon="Open" Label="解压到" Click="Extract_Click"/>
        </CommandBar>

        <GridView Grid.Row="1"
                  x:Name="ArchiveGridView"
                  ItemsSource="{x:Bind ViewModel.ArchiveItems, Mode=OneWay}"
                  SelectionMode="Single"
                  ItemClick="ArchiveGridView_ItemClick"
                  IsItemClickEnabled="True"
                  Padding="16">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ArchiveItem">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16,16,16,16"
                                CornerRadius="8"
                                Margin="8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           MaxWidth="200"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Count, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Foreground="{ThemeResource TextFillColorPrimary}"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Padding="8,8,8,8"/>

    </Grid>

</Page>
