<Page
    x:Class="SevenZipApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,0,8,0">
            <AppBarButton Icon="Save" Label="保存" Click="Save_Settings_Click"/>
        </CommandBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16">
                <TextBlock Text="主题设置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                <StackPanel Margin="0,0,0,16">
                    <RadioButton Content="浅色" GroupName="Theme" IsChecked="True"/>
                    <RadioButton Content="深色" GroupName="Theme"/>
                    <RadioButton Content="系统默认" GroupName="Theme"/>
                </StackPanel>

                <TextBlock Text="语言" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                <ComboBox Margin="0,0,0,16">
                    <ComboBoxItem Content="中文 (简体)"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>

                <TextBlock Text="历史记录" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                <ToggleSwitch Header="保存打开记录" IsOn="True" Margin="0,0,0,8"/>
                <TextBox PlaceholderText="保存记录数量" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
