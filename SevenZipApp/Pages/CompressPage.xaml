<Page
    x:Class="SevenZipApp.Pages.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,0,8,0">
            <AppBarButton Icon="Save" Label="压缩" Click="Compress_Click"/>
            <AppBarButton Icon="Cancel" Label="取消" Click="Cancel_Click"/>
        </CommandBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16">
                <TextBlock Text="选择文件" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" PlaceholderText="已选择文件" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="选择文件" Click="SelectFiles_Click" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="输出文件名" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                <TextBox x:Name="OutputPath" PlaceholderText="例如：archive.7z" Margin="0,0,0,16"/>

                <TextBlock Text="压缩级别" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                <ComboBox x:Name="CompressionLevel" Margin="0,0,0,16">
                    < ComboBoxItem Content="0 - 存储"/>
                    < ComboBoxItem Content="1 - 最快"/>
                    < ComboBoxItem Content="3 - 快速"/>
                    < ComboBoxItem Content="5 - 正常"/>
                    < ComboBoxItem Content="7 - 最大"/>
                    < ComboBoxItem Content="9 - 超压"/>
                </ComboBox>

                <ToggleSwitchContent Grid.Row="1" Content="固实压缩" IsOn="True" Margin="0,0,0,8"/>
                <ToggleSwitchContent Grid.Row="2" Content="多线程压缩" IsOn="True" Margin="0,0,0,8"/>
                <ToggleSwitchContent Grid.Row="3" Content="加密" IsOn="False" Margin="0,0,0,16"/>

                <PasswordBox x:Name="Password" PlaceholderText="密码 (可选)" Margin="0,0,0,16" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Text="准备压缩"
                   Foreground="{ThemeResource TextFillColorPrimary}"
                   Padding="8,8,8,8"/>
    </Grid>
</Page>
