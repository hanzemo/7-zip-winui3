<Page
    x:Class="SevenZipApp.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,0,8,0">
            <AppBarButton Icon="Back" Label="返回" Click="Back_Click"/>
            <AppBarButton Icon="Refresh" Label="刷新" Click="Refresh_Click"/>
            <AppBarButton Icon="Open" Label="解压到" Click="Extract_Click"/>
        </CommandBar>

        <ListView Grid.Row="1"
                  x:Name="FilesListView"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="Single"
                  ItemClick="FilesListView_ItemClick"
                  IsItemClickEnabled="True"
                  Padding="16">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ArchiveItem"
                              xmlns:local="using:SevenZipApp">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Padding="16,12"
                            CornerRadius="4"
                            Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind SizeDisplay, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondary}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorPrimary}"
                   Padding="8,8,8,8"/>
    </Grid>
</Page>
