<Window
    x:Class="SevenZipApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="7-Zip WinUI3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0" x:Name="TitleBarGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="7-Zip WinUI3"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Margin="0,4,0,4"/>

        </Grid>

        <!-- Main Content Area with Navigation -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="LeftExpand"
            BackRequested="NavView_BackRequested"
            ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="主页" Tag="Home"/>
                <NavigationViewItem Icon="Archive" Content="压缩" Tag="Compress"/>
                <NavigationViewItem Icon="Refresh" Content="解压" Tag="Extract"/>
                <NavigationViewItem Icon="DocumentLibrary" Content="文件查看" Tag="FileExplorer"/>
                <NavigationViewItem Icon="Folder" Content="归档" Tag="Archive"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Icon="Settings" Content="设置" Tag="Settings"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="MainFrame"/>

        </NavigationView>
    </Grid>
</Window>
