<Window
    x:Class="SevenZipApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="1000"
    Height="700"
    Title="7-Zip WinUI3"
    AppWindowTheme="Product"
    TitleBar.IsExtensionPresent="True"
    TitleBar.ExtendsContentIntoTitleBar="True"
    RequestedTheme="Light">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏带应用图标和名称 -->
        <Grid Grid.Row="0" Name="TitleBarGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <Image 
                Source="/Assets/SevenZipWinUI.png" 
                Grid.Column="0"
                Height="28"
                Width="28"
                Margin="10,4,8,4" 
                ToolTipService.ToolTip="7-Zip WinUI3"/>

            <!-- App Title -->
            <TextBlock 
                Text="7-Zip WinUI3" 
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Margin="0,4,0,4"/>

        </Grid>

        <!-- Main Content Area with Navigation -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="LeftExpand"
            BackRequested="NavView_BackRequested"
            ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="主页" Tag="Home"/>
                <NavigationViewItem Icon="Archive" Content="压缩" Tag="Compress"/>
                <NavigationViewItem Icon="Refresh" Content="解压" Tag="Extract"/>
                <NavigationViewItem Icon="DocumentLibrary" Content="文件查看" Tag="FileExplorer"/>
                <NavigationViewItem Icon="Folder" Content="归档" Tag="Archive"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Icon="Settings" Content="设置" Tag="Settings"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="MainFrame">
                <Frame.Navigate(typeof(Pages.HomePage));
            </Frame>

        </NavigationView>
    </Grid>
</Window>
